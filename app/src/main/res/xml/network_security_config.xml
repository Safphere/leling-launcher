<?xml version="1.0" encoding="utf-8"?>
<!-- 接口地址由子女自定义，可能指向局域网网关等HTTP服务，故允许明文流量（默认GLM端点本身是HTTPS） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
