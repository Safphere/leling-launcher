<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- 用户消息：右侧蓝色气泡（左上直角，其余大圆角） -->
    <TextView
        android:id="@+id/msgUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="96dp"
        android:background="@drawable/bg_bubble_user"
        android:lineSpacingMultiplier="1.3"
        android:maxWidth="320dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:visibility="gone"
        tools:text="今天天气怎么样"
        tools:visibility="visible" />

    <!-- 助手消息：左侧白底气泡（右上直角），带语音播报按钮 -->
    <LinearLayout
        android:id="@+id/msgAiBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="56dp"
        android:background="@drawable/bg_bubble_ai"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/msgAi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.35"
            android:textColor="#1A1A1A"
            android:textSize="21sp"
            tools:text="今天多云，20到28度，适合出门散步。" />

        <TextView
            android:id="@+id/btnSpeakMsg"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            android:drawableStart="@android:drawable/ic_lock_silent_mode_off"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:text="读给我听"
            android:textColor="#9AA5B1"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
