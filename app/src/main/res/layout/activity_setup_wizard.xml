<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 步骤指示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <View android:id="@+id/dot0" style="@style/WizDotOn" />
        <View android:id="@+id/dot1" style="@style/WizDotOff" />
        <View android:id="@+id/dot2" style="@style/WizDotOff" />
        <View android:id="@+id/dot3" style="@style/WizDotOff" />
    </LinearLayout>

    <TextView
        android:id="@+id/wizTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/wizard_title"
        android:textColor="@color/text_main"
        android:textSize="30sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 步骤1：欢迎 -->
            <LinearLayout
                android:id="@+id/step0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/WizBody"
                    android:text="这个桌面是给爸妈用的：\n\n👤 点联系人头像就能打电话\n\n🔁 电话卡松了会自动提醒并一键重启\n\n🧹 桌面只留最常用的应用，干净清爽\n\n🎤 想问什么按住说话就行\n\n请由子女完成接下来 3 步配置（约 3 分钟）。" />
            </LinearLayout>

            <!-- 步骤2：设为默认桌面 -->
            <LinearLayout
                android:id="@+id/step1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/WizBody"
                    android:text="第 1 步：把「乐龄桌面」设为默认桌面\n\n这样爸妈按 Home 键回到的就是这个简洁桌面，其他应用图标不会出现。" />

                <TextView
                    android:id="@+id/btnSetHome"
                    style="@style/WizAction"
                    android:text="去系统设置选『乐龄桌面』" />

                <TextView
                    style="@style/WizBody"
                    android:text="\n提示：在弹出的列表中选择「乐龄桌面」，并点击「始终」。完成后回到这里点下一步。" />
            </LinearLayout>

            <!-- 步骤3：权限 -->
            <LinearLayout
                android:id="@+id/step2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/WizBody"
                    android:text="第 2 步：一键授权\n\n这些权限用于：点头像直接拨号、从通讯录导入联系人、语音问答。" />

                <TextView
                    android:id="@+id/txtPermPhone"
                    style="@style/WizPerm"
                    android:text="❌ 电话（拨号）" />

                <TextView
                    android:id="@+id/txtPermContacts"
                    style="@style/WizPerm"
                    android:text="❌ 通讯录（导入联系人）" />

                <TextView
                    android:id="@+id/txtPermMic"
                    style="@style/WizPerm"
                    android:text="❌ 麦克风（语音问答）" />

                <TextView
                    android:id="@+id/txtPermSms"
                    style="@style/WizPerm"
                    android:text="❌ 短信（每天自动查询流量）" />

                <TextView
                    android:id="@+id/btnGrantPerms"
                    style="@style/WizAction"
                    android:text="一键授权" />

                <TextView
                    android:id="@+id/btnPermStatus"
                    style="@style/WizActionGray"
                    android:layout_width="match_parent"
                    android:layout_marginTop="10dp"
                    android:text="小米没弹授权框？点这里检查权限状态" />
            </LinearLayout>

            <!-- 步骤4：联系人 + 完成 -->
            <LinearLayout
                android:id="@+id/step3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/WizBody"
                    android:text="第 3 步：添加常用联系人\n\n把爸妈经常打电话的人加上（子女、亲戚、邻居），他们的头像会出现在桌面上，点了就拨号。" />

                <TextView
                    android:id="@+id/btnAddContact"
                    style="@style/WizAction"
                    android:text="＋ 添加联系人" />

                <TextView
                    style="@style/WizBody"
                    android:text="\n其他（SIM 检测时间、AI 设置、白名单）以后都能在桌面右下角「子女设置」里修改。\n\n都弄好了？点「完成」交给爸妈使用吧！" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <!-- 底部导航 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/btnPrev"
            style="@style/WizActionGray"
            android:text="上一步" />

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_blue"
            android:gravity="center"
            android:text="下一步"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
