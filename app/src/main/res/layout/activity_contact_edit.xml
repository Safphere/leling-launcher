<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:text="← 返回"
                android:textColor="@color/blue"
                android:textSize="20sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnImport"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:text="📥 从通讯录导入"
                android:textColor="@color/green"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- 头像预览 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:id="@+id/avatarImg"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:contentDescription="@string/contact_avatar"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/avatarPreset"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:textSize="64sp"
                    tools:text="👴" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/btnPickAvatar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:text="📷 从相册选头像"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <!-- 预设头像 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/preset_avatar"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/presetGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="8" />

        <!-- 表单 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/contact_name"
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_card"
            android:hint="例如：儿子"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/contact_phone"
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/editPhone"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_card"
            android:hint="长号，例如 138xxxx5678"
            android:inputType="phone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/contact_short"
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/editShort"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_card"
            android:hint="例如：631"
            android:inputType="phone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="22sp" />



        <!-- 保存 / 删除 -->
        <TextView
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_blue"
            android:gravity="center"
            android:text="@string/save"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_add_contact"
            android:gravity="center"
            android:text="@string/delete"
            android:textColor="@color/red"
            android:textSize="20sp" />
    </LinearLayout>
</ScrollView>
