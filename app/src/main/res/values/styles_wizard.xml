<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WizDotOn">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_btn_blue</item>
    </style>

    <style name="WizDotOff">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_add_contact</item>
    </style>

    <style name="WizBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="WizAction">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:background">@drawable/bg_btn_green</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WizActionGray">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@drawable/bg_add_contact</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="WizPerm">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">19sp</item>
    </style>
</resources>
